{
  "functions": {
    "api/proxy.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin/", "dest": "/admin.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
